NODE_ENV=development
PORT=5000
# Local MongoDB, or paste your MongoDB Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017/smart-pg-manager
# At least 32 random characters (see the command below)
JWT_SECRET=replace_me_with_a_long_random_string
JWT_EXPIRES_IN=7d
# Frontend URL(s), comma separated
CLIENT_URL=http://localhost:5173