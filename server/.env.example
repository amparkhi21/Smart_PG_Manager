# Copy to .env for local development only. Set real production values in Render.
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb+srv://<db-user>:<url-encoded-password>@<atlas-host>/<existing-database>?retryWrites=true&w=majority
JWT_SECRET=<unique-random-secret-at-least-32-characters>
JWT_EXPIRES_IN=7d
# Exact origins only; comma-separated. Production requires HTTPS.
CLIENT_URL=http://localhost:5173
# Production: NODE_ENV=production, CLIENT_URL=https://<project>.vercel.app
# Capacitor Android: append ,https://localhost to the existing production CLIENT_URL.
# Keep all existing website origins; other loopback origins remain disallowed.
# Render supplies PORT automatically; do not set it to a localhost URL.

# Optional Android push. Keep false until the Firebase service account is configured.
FCM_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# PEM private key from your service account; escaped \n is supported. Server secret only.
FIREBASE_PRIVATE_KEY=
# Independent random 32-byte key, encoded as 64 hexadecimal characters. Never reuse JWT_SECRET.
FCM_TOKEN_ENCRYPTION_KEY=

# Optional AI mess planner. Server-only; never use a VITE_ prefix for this key.
# Use a Google AI Studio free-tier key; no billing setup is required by this app.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
